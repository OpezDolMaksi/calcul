<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Сумма счета:"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/editTextAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Например: 1000"
        android:inputType="numberDecimal" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Количество блюд:"
        android:textSize="16sp"
        android:layout_marginTop="12dp" />

    <EditText
        android:id="@+id/editTextDishes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Целое число"
        android:inputType="number" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Чаевые (%):"
        android:textSize="16sp"
        android:layout_marginTop="12dp" />

    <SeekBar
        android:id="@+id/seekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="25" />

    <TextView
        android:id="@+id/sliderValueText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Процент чаевых: 0%"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Диапазон: 0–25%, шаг 5%"
        android:textSize="12sp"
        android:textColor="@android:color/darker_gray" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Скидка (выбирается автоматически):"
        android:textSize="16sp"
        android:layout_marginTop="12dp" />

    <RadioGroup
        android:id="@+id/radioGroupDiscount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/radioDiscount1_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1-2 блюда – 3%" />

        <RadioButton
            android:id="@+id/radioDiscount3_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3-5 блюд – 5%" />

        <RadioButton
            android:id="@+id/radioDiscount6_10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="6-10 блюд – 7%" />

        <RadioButton
            android:id="@+id/radioDiscountMore10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Более 10 блюд – 10%" />
    </RadioGroup>

    <TextView
        android:id="@+id/resultDisplayText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Скидка: 0.00"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        android:padding="8dp"
        android:background="@android:drawable/editbox_background" />

    <Button
        android:id="@+id/buttonTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Итого"
        android:layout_marginTop="8dp"
        android:layout_gravity="center" />

</LinearLayout>